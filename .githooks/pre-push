#!/bin/sh
set -eu
scanner=$(git config --local --get publicPrivacy.gitleaks || true)
if [ -z "$scanner" ]; then scanner=gitleaks; fi
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
  python scripts/security/check-public-privacy.py --mode history --ref "$local_oid" --gitleaks "$scanner" || exit $?
done
